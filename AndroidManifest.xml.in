<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.couple.xiaowo.order"
    android:versionCode="35"
    android:versionName="3.7.7">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 系统通知（Android 13+ 需要运行时申请） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮窗：让对方发来的爱心和消息直接飘到屏幕上 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 锁屏也能显示全屏通知（vivo 锁屏弹出提醒靠它） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Android 14+ 里，从后台弹悬浮窗需要声明这个，否则会被系统拦 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 自动更新：下载新版本后调起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
        接单端保存收到的截图到相册。
        Android 10+ 走 MediaStore 完全不需要这个权限；
        这里声明并加 maxSdkVersion，只为照顾 Android 9 及以下的老机器，
        且不会在 10+ 上向用户索要（系统直接忽略）。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- 前台服务保活（Android 14+ 必须声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 16/17 的「本地网络」权限：老系统上写进清单也无害 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:label="@APP_LABEL@"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="com.couple.xiaowo.ui.MainActivity"
            android:exported="true"
            android:label="@APP_LABEL@"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 后台保活：前台服务 + 常驻通知 -->
        <service
            android:name="com.couple.xiaowo.core.KeepAlive"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            静默截屏：无障碍服务。**只打进点单端**（@SHOT_SERVICE@ 在 build.sh 里按角色替换）。

            为什么只有点单端需要：
              截图的方向是「接单端请求 → 点单端的屏幕」。被截的那一端才是
              需要无障碍的那一端。接单端只负责显示收到的图，它自己的屏幕
              没人要看，给它塞一个无障碍服务只会多一项要用户授权的敏感权限。

            为什么用无障碍：Android 11 (API 30) 给 AccessibilityService 加了
            takeScreenshot()，配置里声明 canTakeScreenshot="true" 并处于运行状态时，
            能直接拿到整屏 Bitmap，没有任何确认弹窗。MediaProjection 做不到静默。

            授权只做一次，metadata 指向 res/xml/shot_service.xml。
        -->
        @SHOT_SERVICE@

        <!-- 自动更新用：把下载好的 APK 以 content:// 交给系统安装器 -->
        <provider
            android:name="com.couple.xiaowo.core.ApkFileProvider"
            android:authorities="@PKG@.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
